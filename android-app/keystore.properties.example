# 签名配置模板
# ---------------------------------------------------------------------------
# 复制本文件为 keystore.properties 并填入你自己的值：
#     cp keystore.properties.example keystore.properties
#
# keystore.properties 已被 .gitignore 排除，不会进仓库。
#
# ★ 如果既没有 keystore 也没有本文件，构建会**自动退回 debug 签名**，
#   clone 下来开箱即可构建，只是 APK 未签名（仍可安装使用）。
#   预编译好的正式签名 APK 在仓库的 apk/ 目录下。
# ---------------------------------------------------------------------------
storeFile=../keystore/vpnshare.jks
storePassword=你的密码
keyAlias=vpnshare
keyPassword=你的密码
